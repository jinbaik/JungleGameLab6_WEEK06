%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4af3e482865c49747941e483722a6cd8, type: 3}
  m_Name: CustomizationTutorial
  m_EditorClassIdentifier: Assembly-CSharp::Game.Tutorials.TutorialContent
  _cards:
  - _topic: 0
    _title: "하부 하우징부터 키보드 완성하기"
    _body: "하부 하우징을 작업대에 고정한 뒤 PCB부터 조립하세요.\n필요한 부품은 작업대 뒤쪽 서랍에서 꺼낼 수 있습니다."
    _controls: "<b>[Q / E]</b> 시점 전환   <b>[F10]</b> 도움말"
  - _topic: 1
    _title: "하부 하우징을 작업대에 놓으세요"
    _body: "하부 하우징을 작업대 배치 영역으로 끌어다 놓으세요.\n작업대에 고정되면 한 번 클릭해 작업 모드로 들어가세요."
    _controls: "<b>[좌클릭 드래그 후 놓기]</b> 하부 하우징 배치"
  - _topic: 30
    _title: "하부 하우징을 클릭해 작업 시작"
    _body: "하부 하우징이 작업대에 놓였습니다.\n배치된 하부 하우징을 드래그하지 말고 한 번 좌클릭하면 작업 모드로 들어갑니다."
    _controls: "<b>[배치된 하부 하우징 좌클릭]</b> 작업 모드 진입"
  - _topic: 2
    _title: "서랍을 눌러 부품 꺼내기"
    _body: "작업대 뒤쪽 서랍의 앞판이나 손잡이를 누르세요.\n서랍이 화면에 펼쳐지면 원하는 부품을 끌어다 놓으세요."
    _controls: "<b>[서랍 좌클릭]</b> 열기·전환\n<b>[Esc]</b> 작업 모드 나가기"
  - _topic: 17
    _title: "펼쳐진 서랍에서 부품 고르기"
    _body: "목록을 스크롤해 원하는 부품을 찾으세요.\n부품 카드를 누른 채 설치할 자리로 옮기고 놓으세요."
    _controls: "<b>[휠]</b> 목록 이동   <b>[카드 드래그]</b> 설치\n닫기 버튼이나 열린 수납칸을 누르면 서랍이 닫힙니다."
  - _topic: 29
    _title: "하부 하우징부터 순서대로 조립하세요"
    _body: "하부 하우징 → PCB → 나사 6개 → 보강판 → 스위치 → 상단부 → 키캡 순서입니다.\n하부 하우징을 놓았으니 이제 PCB를 설치하세요."
    _controls: "보강판은 상단부와 키캡을 끼우기 전에 설치하세요."
  - _topic: 22
    _title: "하부 하우징 다루기"
    _body: "준비된 하부 하우징을 그대로 사용하세요.\n분리했다면 서랍의 재질 카드를 원래 자리에 놓으세요."
    _controls: "<b>[빈 하부 하우징 드래그]</b> 분리\n연결된 부품과 나사가 없어야 분리할 수 있습니다."
  - _topic: 24
    _title: "하부 하우징 위에 PCB 놓기"
    _body: "PCB 서랍의 카드를 하부 하우징 안쪽에 끌어다 놓으세요.\n설치 후 표시되는 나사 6개를 모두 조이세요."
    _controls: "<b>[PCB 카드 드래그 후 놓기]</b> 설치"
  - _topic: 27
    _title: "PCB 나사 6개를 조이세요"
    _body: "PCB 서랍을 연 상태에서 주황색 나사를 클릭하세요.\n체결되면 초록색으로 바뀌며 다시 누르면 풀립니다."
    _controls: "<b>[나사 좌클릭]</b> 조이기·풀기\n보강판과 상단부를 분리해야 조작할 수 있습니다."
  - _topic: 23
    _title: "PCB 위에 보강판 놓기"
    _body: "나사 6개를 조인 뒤 보강판 재질 카드를 끌어다 놓으세요.\n상단부나 키캡이 있으면 먼저 분리해야 합니다."
    _controls: "<b>[재질 카드 드래그]</b> 설치\n<b>[설치된 보강판 드래그]</b> 분리"
  - _topic: 5
    _title: "빈 자리에 스위치 끼우기"
    _body: "원하는 스위치 카드를 PCB의 빈 자리에 놓으세요.\nPCB 나사 6개를 모두 조여야 설치할 수 있습니다."
    _controls: "<b>[스위치 카드 드래그 후 놓기]</b> 설치\n이미 스위치나 키캡이 있는 자리에는 놓을 수 없습니다."
  - _topic: 28
    _title: "상단부 씌우기"
    _body: "상단부 서랍의 재질 카드를 키보드에 끌어다 놓으세요.\nPCB 나사와 보강판 작업을 마친 뒤 씌우는 것을 권장합니다."
    _controls: "<b>[재질 카드 드래그]</b> 설치\n<b>[설치된 상단부 드래그]</b> 분리"
  - _topic: 3
    _title: "스위치 위에 키캡 끼우기"
    _body: "키캡 카드를 스위치가 있는 빈 자리에 놓으세요.\n키캡이 이미 있으면 풀러로 먼저 빼야 합니다."
    _controls: "<b>[키캡 카드 드래그 후 놓기]</b> 설치\n해당 자리에 스위치가 필요합니다."
  - _topic: 6
    _title: "여러 자리에 연속으로 끼우기"
    _body: "서랍의 일괄 배치를 선택하고 버튼을 누른 채 이동하세요.\n설치 가능한 빈 슬롯에 부품이 하나씩 들어갑니다."
    _controls: "안내를 닫은 뒤 다시 누른 채 움직이세요.\n<b>[버튼 놓기]</b> 연속 설치 종료"
  - _topic: 26
    _title: "풀러를 꺼내 바로 사용하세요"
    _body: "풀러 카드를 누른 채 부품 위로 움직이세요.\n키캡을 먼저 빼고 스위치를 뽑으세요. 놓은 풀러는 다시 집을 수 있습니다."
    _controls: "<b>[좌클릭 유지 → 부품 위로 이동]</b> 분리\n<b>[놓기]</b> 현재 위치 아래에 내려놓기 · <b>[도구 서랍에 놓기]</b> 보관"
  - _topic: 18
    _title: "구조 부품은 순서대로 분리하세요"
    _body: "상단부와 키캡을 빼면 보강판을 분리할 수 있습니다.\n보강판을 빼고 나사 6개를 모두 풀면 PCB도 분리할 수 있습니다."
    _controls: "<b>[해당 서랍 열기 → 설치된 부품 드래그]</b> 분리"
  - _topic: 19
    _title: "뺀 자리에 다른 부품 끼우기"
    _body: "비워진 자리에 원하는 스위치나 키캡을 다시 놓으세요.\n스위치를 바꿀 때는 그 위의 키캡부터 빼야 합니다."
    _controls: "<b>[원하는 카드 드래그 → 빈 자리에 놓기]</b> 교체"
  - _topic: 20
    _title: "꺼낸 부품 정리하기"
    _body: "분리한 부품을 열린 서랍 안에 놓으면 보관됩니다.\n다시 장착하려면 키보드의 원래 자리에 놓으세요."
    _controls: "<b>[분리한 부품 드래그 후 놓기]</b> 보관·재설치"
  - _topic: 21
    _title: "부품이 들어가지 않나요?"
    _body: "그 자리가 비어 있는지 먼저 확인하세요.\n스위치는 PCB 나사 체결이 끝나야 하고, 키캡은 아래에 스위치가 있어야 합니다."
    _controls: "아티산은 1u 크기의 빈 자리에 설치하세요."
  - _topic: 7
    _title: "아티산 키캡 끼우기"
    _body: "아티산은 정사각형 한 칸 크기인 1u 자리에 놓을 수 있습니다.\n스위치가 있고 키캡이 없는 자리를 골라 주세요."
    _controls: "<b>[아티산 카드 드래그 후 놓기]</b> 설치"
  - _topic: 25
    _title: "LED·커스텀 이미지 서랍"
    _body: "공용 서랍의 LED 탭에서 전원과 색상·밝기를 바꾸세요.\n패턴과 속도를 조절해 조명 효과를 확인하세요."
    _controls: "<b>[LED·커스텀 이미지 서랍 → LED 탭]</b>"
  - _topic: 4
    _title: "키보드에 사진 입히기"
    _body: "LED·커스텀 이미지 서랍에서 커스텀 이미지 탭을 고르세요.\n사진을 불러와 위치와 범위를 조절한 뒤 적용하세요."
    _controls: "<b>[커스텀 이미지 탭]</b> 사진 선택 → 조절 → 적용"
  - _topic: 15
    _title: "완성한 키보드 두드려 보기"
    _body: "실제 키를 눌러 설치한 스위치와 키캡의 반응을 확인하세요.\n공격 테스트를 켜면 타건에 따른 공격 연출도 확인할 수 있습니다."
    _controls: "<b>[실제 키 입력]</b> 타건\n일반 모드로 바꾸면 공격 테스트가 꺼집니다."
  - _topic: 31
    _title: "도구 서랍의 두 가지 풀러"
    _body: "키캡 풀러는 키캡을, 스위치 풀러는 스위치를 뽑습니다.\n카드를 누른 채 꺼내 바로 사용하고, 놓으면 현재 위치 아래에 내려놓습니다."
    _controls: "<b>[카드 또는 작업대 풀러 드래그]</b> 사용\n사용 후 <b>[열린 도구 서랍으로 드래그해 놓기]</b> 보관"
  - _topic: 34
    _title: "모니터 사용하기"
    _body: "모니터 앞에 키보드가 설치되었습니다.\nQ/E로 모니터 시점으로 이동한 뒤 화면을 클릭하세요."
    _controls: "<b>[아이콘 더블클릭]</b> 앱 실행\n<b>[Esc]</b> 모니터 조작 종료"
  - _topic: 32
    _title: "고객 메일에서 의뢰 확인하기"
    _body: "고객 이름을 펼치고 하위 메일을 선택하세요.\n요구사항을 읽고 의뢰 수락 후 제출 대상을 선택하세요."
    _controls: "<b>[고객 클릭]</b> 펼치기·접기\n<b>[삭제 / 복원]</b> 휴지통 이동·되돌리기"
  - _topic: 33
    _title: "선택한 의뢰로 키보드 보내기"
    _body: "완성한 키보드를 배송 트레이에 올리세요.\n단말기에서 고객과 의뢰를 확인한 뒤 발송하세요."
    _controls: "Q/E로 배송 시점 이동 → 발송 → 확인\n발송한 키보드는 돌려받을 수 없습니다."
  - _topic: 35
    _title: "검수 결과 메일 확인하기"
    _body: "발송한 키보드의 검수 결과 메일이 도착했습니다.\n메일 앱에서 고객 목록을 펼쳐 결과를 확인하세요."
    _controls: "실패했다면 메일의 부족 내역을 확인하세요."
