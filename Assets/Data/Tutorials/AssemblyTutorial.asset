--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4af3e482865c49747941e483722a6cd8, type: 3}
  m_Name: AssemblyTutorial
  m_EditorClassIdentifier: Assembly-CSharp::Game.Tutorials.TutorialContent
  _cards:
  - _topic: 0
    _title: "\uD0A4\uBCF4\uB4DC\uB97C \uC9C1\uC811 \uC870\uB9BD\uD574 \uBCF4\uC138\uC694"
    _body: "\uD0A4\uCEA1\uACFC \uC2A4\uC704\uCE58\uB97C \uC9C1\uC811 \uC9D1\uC5B4
      \uC6D0\uD558\uB294 \uC704\uCE58\uC5D0 \uC124\uCE58\uD574 \uBCF4\uC138\uC694.\n\uD654\uBA74
      \uC67C\uCABD \uC704\uC758 [UI \uD3BC\uCE58\uAE30] \uBC84\uD2BC\uC744 \uB20C\uB7EC
      \uD30C\uCE20 \uBAA9\uB85D\uC744 \uC5F4\uACE0 \uC9C4\uD589\uD558\uC138\uC694.\nESC
      \uD0A4\uCEA1 \uD558\uB098\uAC00 \uBD84\uB9AC\uB418\uC5B4 \uC788\uC73C\uB2C8
      \uC9C1\uC811 \uB07C\uC6CC \uBCFC \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    _controls: "[\uC88C\uD074\uB9AD \uB4DC\uB798\uADF8] \uD30C\uCE20 \uC774\uB3D9
      \xB7 [\uB9C8\uC6B0\uC2A4 \uB193\uAE30] \uC124\uCE58 \xB7 [F10] \uB3C4\uC6C0\uB9D0"
  - _topic: 17
    _title: "\uD30C\uCE20 \uBAA9\uB85D\uC5D0\uC11C \uACE8\uB77C \uBCF4\uC138\uC694"
    _body: "\uD0ED\uC744 \uB20C\uB7EC \uD0A4\uCEA1\uACFC \uC2A4\uC704\uCE58 \uB4F1
      \uD30C\uCE20 \uC885\uB958\uB97C \uC120\uD0DD\uD558\uC138\uC694.\n\uCE74\uB4DC\uC5D0
      \uB0A8\uC740 \uC218\uB7C9\uC774 \uD45C\uC2DC\uB418\uBA70, \uCE74\uB4DC\uB97C
      \uD0A4\uBCF4\uB4DC \uCABD\uC73C\uB85C \uB04C\uBA74 \uD30C\uCE20\uB97C \uAEBC\uB0BC
      \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uD604\uC7AC \uAE30\uBCF8 \uC120\uD0DD\uC740
      \uD0A4\uCEA1\uC785\uB2C8\uB2E4."
    _controls: "[\uD0ED \uD074\uB9AD] \uC885\uB958 \uC120\uD0DD \xB7 [\uD720] \uBAA9\uB85D
      \uC2A4\uD06C\uB864 \xB7 [UI \uC811\uAE30] \uBAA9\uB85D \uB2EB\uAE30"
  - _topic: 2
    _title: "\uD30C\uCE20\uB97C \uC9D1\uACE0 \uC62E\uAE30\uAE30"
    _body: "\uC88C\uD074\uB9AD\uC744 \uC720\uC9C0\uD55C \uCC44 \uC6C0\uC9C1\uC774\uBA74
      \uD30C\uCE20\uAC00 \uB9C8\uC6B0\uC2A4\uB97C \uB530\uB77C\uC635\uB2C8\uB2E4.\n\uD638\uD658\uB418\uB294
      \uC2AC\uB86F \uADFC\uCC98\uC5D0\uC11C \uBC84\uD2BC\uC744 \uB193\uC73C\uBA74
      \uD574\uB2F9 \uC704\uCE58\uC5D0 \uC7A5\uCC29\uB429\uB2C8\uB2E4.\n\uBAA9\uB85D
      \uC704\uC5D0\uC11C\uB294 \uC544\uC774\uCF58\uC73C\uB85C, \uC791\uC5C5 \uACF5\uAC04\uC5D0\uC11C\uB294
      \uC2E4\uC81C \uD30C\uCE20\uB85C \uD45C\uC2DC\uB429\uB2C8\uB2E4."
    _controls: "[\uC88C\uD074\uB9AD \uB4DC\uB798\uADF8] \uC774\uB3D9 \xB7 [\uB9C8\uC6B0\uC2A4
      \uB193\uAE30] \uB0B4\uB824\uB193\uAE30"
  - _topic: 18
    _title: "\uC124\uCE58\uB41C \uD30C\uCE20 \uBD84\uB9AC\uD558\uAE30"
    _body: "\uC124\uCE58\uB41C \uD0A4\uCEA1\uC774\uB098 \uC2A4\uC704\uCE58\uB3C4
      \uC9C1\uC811 \uC9D1\uC5B4 \uBD84\uB9AC\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uBD84\uB9AC\uD55C
      \uD30C\uCE20\uB294 \uB2E4\uB978 \uD638\uD658 \uC2AC\uB86F\uC5D0 \uC124\uCE58\uD558\uAC70\uB098
      \uBAA9\uB85D\uC73C\uB85C \uBC18\uD658\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    _controls: "[\uC124\uCE58\uB41C \uD30C\uCE20\uB97C \uC88C\uD074\uB9AD \uB4DC\uB798\uADF8]
      \uBD84\uB9AC"
  - _topic: 20
    _title: "\uD30C\uCE20 \uBC18\uD658\uACFC \uC218\uB7C9"
    _body: "\uBAA9\uB85D\uC758 \uBC18\uD658 \uC601\uC5ED\uC5D0 \uD30C\uCE20\uB97C
      \uB193\uC73C\uBA74 \uC7AC\uACE0\uB85C \uB3CC\uB824\uBCF4\uB0BC \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uBC18\uD658\uB41C
      \uD30C\uCE20\uB9CC\uD07C \uBAA9\uB85D\uC758 \uC218\uB7C9\uC774 \uB298\uC5B4\uB098\uBA70
      \uB2E4\uC2DC \uAEBC\uB0B4 \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    _controls: "[\uD30C\uCE20\uB97C \uBAA9\uB85D \uBC18\uD658 \uC601\uC5ED\uC73C\uB85C
      \uB4DC\uB798\uADF8] \uC7AC\uACE0\uB85C \uBC18\uD658"
  - _topic: 3
    _title: "\uD0A4\uCEA1\uC744 \uD558\uB098\uC529 \uC124\uCE58\uD558\uAE30"
    _body: "\uD0A4\uCEA1 \uCE74\uB4DC\uB97C \uB204\uB978 \uCC44 \uC6D0\uD558\uB294
      \uD0A4 \uC704\uCE58\uB85C \uB193\uC73C\uC138\uC694.\n\uC77C\uBC18 \uC7AC\uC9C8
      \uD0A4\uCEA1\uC740 \uC124\uCE58\uD560 \uC2AC\uB86F\uC758 \uD06C\uAE30\uC640
      \uBAA8\uC591\uC5D0 \uB9DE\uCDB0\uC9D1\uB2C8\uB2E4.\n\uD0A4\uCEA1\uC744 \uC5EC\uB7EC
      \uAC1C \uBE7C\uACE0 \uC2F6\uB2E4\uBA74, \uC791\uC5C5\uB300 \uC704\uC758 \uD0A4\uCEA1
      \uD480\uB7EC\uB97C \uD074\uB9AD\uD558\uC138\uC694."
    _controls: "[\uBAA9\uB85D\uC5D0\uC11C \uB4DC\uB798\uADF8] \uD0A4\uCEA1 \uAEBC\uB0B4\uAE30
      \xB7 [\uC2AC\uB86F \uADFC\uCC98\uC5D0\uC11C \uB193\uAE30] \uD55C \uAC1C \uC124\uCE58"
  - _topic: 6
    _title: "\uD0A4\uCEA1 \uC5EC\uB7EC \uAC1C \uC124\uCE58\uD558\uAE30"
    _body: "\uADF8\uB9BC\uC744 \uADF8\uB9AC\uB4EF \uC5EC\uB7EC \uD0A4\uCEA1\uC744
      \uC5F0\uC18D\uC73C\uB85C \uC124\uCE58\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uB9C8\uC6B0\uC2A4
      \uBC84\uD2BC\uC744 \uB204\uB978 \uCC44 \uD0A4\uBCF4\uB4DC \uC704\uB97C \uC6C0\uC9C1\uC774\uBA74
      \uC9C0\uB098\uAC00\uB294 \uC704\uCE58\uB9C8\uB2E4 \uD0A4\uCEA1\uC774 \uC124\uCE58\uB429\uB2C8\uB2E4."
    _controls: "[\uC77C\uAD04 \uBC30\uCE58] \uBAA8\uB4DC \uC804\uD658 \xB7 [\uD0A4\uCEA1
      \uCE74\uB4DC \uAFB9 \uB204\uB974\uAE30] \uD0A4\uCEA1 \uC120\uD0DD \xB7 [\uB204\uB978
      \uCC44 \uB4DC\uB798\uADF8] \uC5F0\uC18D \uC124\uCE58"
  - _topic: 7
    _title: "\uC544\uD2F0\uC0B0 \uD0A4\uCEA1\uC73C\uB85C \uAFB8\uBBF8\uAE30"
    _body: "\uC544\uD2F0\uC0B0\uC740 \uACE0\uC720\uD55C \uBAA8\uC591\uC744 \uC720\uC9C0\uD558\uBA70
      \uAC19\uC740 \uD0A4\uCEA1 \uADDC\uACA9\uC758 \uC2AC\uB86F\uC5D0\uB9CC \uC124\uCE58\uB429\uB2C8\uB2E4.\n\uC77C\uBC18
      \uC7AC\uC9C8 \uD0A4\uCEA1\uCC98\uB7FC \uAE34 \uD0A4\uC758 \uBAA8\uC591\uC73C\uB85C
      \uB298\uC5B4\uB098\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\n\uC7A5\uCC29 \uAC1C\uC218
      \uC81C\uD55C\uC740 \uC5C6\uC73C\uBA70 \uBAA9\uB85D\uC5D0 \uB0A8\uC740 \uC218\uB7C9\uB9CC\uD07C
      \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    _controls: "[\uC544\uD2F0\uC0B0 \uCE74\uB4DC \uB4DC\uB798\uADF8] \uAEBC\uB0B4\uAE30
      \xB7 [\uD638\uD658 \uC2AC\uB86F\uC5D0 \uB193\uAE30] \uC124\uCE58"
  - _topic: 26
    _title: "\uD0A4\uCEA1 \uC5EC\uB7EC \uAC1C \uBD84\uB9AC\uD558\uAE30"
    _body: "\uC791\uC5C5\uB300 \uC704\uC758 \uD0A4\uCEA1 \uD480\uB7EC\uB85C \uC5EC\uB7EC
      \uD0A4\uCEA1\uC744 \uBE60\uB974\uAC8C \uBD84\uB9AC\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uD480\uB7EC\uB97C
      \uB204\uB978 \uCC44 \uD0A4\uBCF4\uB4DC \uC704\uB97C \uC6C0\uC9C1\uC774\uBA74
      \uC9C0\uB098\uAC00\uB294 \uC704\uCE58\uC758 \uD0A4\uCEA1\uC774 \uBE60\uC9D1\uB2C8\uB2E4.\n\uB9C8\uC6B0\uC2A4
      \uBC84\uD2BC\uC744 \uB193\uC73C\uBA74 \uD480\uB7EC\uB294 \uC6D0\uB798 \uC790\uB9AC\uB85C
      \uB3CC\uC544\uAC11\uB2C8\uB2E4."
    _controls: "[\uD480\uB7EC\uB97C \uC88C\uD074\uB9AD\uD55C \uCC44 \uB4DC\uB798\uADF8]
      \uD0A4\uCEA1 \uC5F0\uC18D \uBD84\uB9AC \xB7 [\uBC84\uD2BC \uB193\uAE30] \uD480\uB7EC
      \uB3CC\uB824\uB193\uAE30"
  - _topic: 5
    _title: "\uC2A4\uC704\uCE58 \uD558\uB098\uC529 \uC124\uCE58\uD558\uAE30"
    _body: "\uC2A4\uC704\uCE58 \uCE74\uB4DC\uB97C \uB204\uB978 \uCC44 \uC2A4\uC704\uCE58
      \uC2AC\uB86F\uC73C\uB85C \uB04C\uC5B4 \uB193\uC73C\uC138\uC694.\n\uC2A4\uC704\uCE58\uB294
      \uC2A4\uC704\uCE58 \uC2AC\uB86F\uC5D0\uB9CC \uC124\uCE58\uB418\uBA70 \uD0A4\uCEA1
      \uC2AC\uB86F\uC5D0\uB294 \uC124\uCE58\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    _controls: "[\uC2A4\uC704\uCE58 \uCE74\uB4DC \uB4DC\uB798\uADF8] \uAEBC\uB0B4\uAE30
      \xB7 [\uC2A4\uC704\uCE58 \uC2AC\uB86F\uC5D0 \uB193\uAE30] \uC124\uCE58"
  - _topic: 21
    _title: "\uC124\uCE58\uD560 \uC218 \uC5C6\uB294 \uC704\uCE58"
    _body: "\uC2A4\uC704\uCE58\uB294 \uC2A4\uC704\uCE58 \uC2AC\uB86F\uC5D0, \uD0A4\uCEA1\uC740
      \uD0A4\uCEA1 \uC2AC\uB86F\uC5D0\uB9CC \uC124\uCE58\uB429\uB2C8\uB2E4.\n\uACE0\uC815\uB41C
      \uBAA8\uC591\uC758 \uD0A4\uCEA1\uACFC \uC544\uD2F0\uC0B0\uC740 \uC2AC\uB86F\uC758
      \uD0A4\uCEA1 \uADDC\uACA9\uB3C4 \uAC19\uC544\uC57C \uD569\uB2C8\uB2E4.\n\uC124\uCE58\uD560
      \uC218 \uC5C6\uB294 \uACF3\uC5D0 \uB193\uC73C\uBA74 \uD30C\uCE20 \uC885\uB958\uC5D0
      \uB530\uB77C \uC6D0\uC704\uCE58\uB85C \uB3CC\uC544\uAC00\uAC70\uB098 \uC791\uC5C5\uB300\uC5D0
      \uB5A8\uC5B4\uC9D1\uB2C8\uB2E4."
    _controls: "\uD30C\uCE20 \uC885\uB958\uC640 \uD0A4\uCEA1 \uADDC\uACA9\uC744 \uD655\uC778\uD558\uACE0
      \uC2AC\uB86F \uADFC\uCC98\uC5D0 \uB193\uC73C\uC138\uC694."
  - _topic: 19
    _title: "\uAE30\uC874 \uD30C\uCE20 \uAD50\uCCB4\uD558\uAE30"
    _body: "\uC774\uBBF8 \uD30C\uCE20\uAC00 \uC788\uB294 \uC2AC\uB86F\uC5D0\uB3C4
      \uB2E4\uB978 \uD638\uD658 \uD30C\uCE20\uB97C \uC124\uCE58\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uC0C8
      \uD30C\uCE20\uB97C \uC7A5\uCC29\uD558\uBA74 \uAE30\uC874 \uD30C\uCE20\uB294
      \uBD84\uB9AC\uB418\uC5B4 \uC791\uC5C5\uB300\uC5D0 \uB5A8\uC5B4\uC9D1\uB2C8\uB2E4.\n\uBD84\uB9AC\uB41C
      \uD30C\uCE20\uB294 \uB2E4\uC2DC \uC9D1\uAC70\uB098 \uBAA9\uB85D\uC73C\uB85C
      \uBC18\uD658\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    _controls: "[\uC0C8 \uD30C\uCE20\uB97C \uC810\uC720\uB41C \uC2AC\uB86F\uC5D0
      \uB193\uAE30] \uAD50\uCCB4"
  - _topic: 22
    _title: "\uCF00\uC774\uC2A4 \uC0B4\uD3B4\uBCF4\uAE30"
    _body: "\uCF00\uC774\uC2A4\uB294 \uD0A4\uBCF4\uB4DC\uC758 \uBC14\uAE65\uC744
      \uAC10\uC2F8\uBA70 \uC804\uCCB4\uC801\uC778 \uC778\uC0C1\uC744 \uACB0\uC815\uD558\uB294
      \uD30C\uCE20\uC785\uB2C8\uB2E4.\n\uC6D0\uD558\uB294 \uC0C9\uC0C1\uACFC \uC7AC\uC9C8\uC744
      \uACE8\uB77C \uD0A4\uCEA1\uACFC \uC5B4\uC6B8\uB9AC\uB294 \uD0A4\uBCF4\uB4DC\uB97C
      \uB9CC\uB4E4\uC5B4 \uBCF4\uC138\uC694.\n\uAC19\uC740 \uD0A4\uCEA1\uB3C4 \uCF00\uC774\uC2A4\uC640\uC758
      \uC870\uD569\uC5D0 \uB530\uB77C \uB2E4\uB978 \uBD84\uC704\uAE30\uB97C \uB0BC
      \uC218 \uC788\uC2B5\uB2C8\uB2E4"
    _controls: "\uCF00\uC774\uC2A4 \uD0ED\uC5D0\uC11C \uC7AC\uC9C8 \uBAA9\uB85D\uC744
      \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - _topic: 23
    _title: "\uBCF4\uAC15\uD310 \uC0B4\uD3B4\uBCF4\uAE30"
    _body: "\uBCF4\uAC15\uD310\uC740 \uC2A4\uC704\uCE58\uC758 \uC704\uCE58\uB97C
      \uC7A1\uC544 \uC8FC\uACE0 \uB2E8\uB2E8\uD558\uAC8C \uC9C0\uC9C0\uD558\uB294
      \uD30C\uCE20\uC785\uB2C8\uB2E4.\n\uC7AC\uC9C8\uC5D0 \uB530\uB77C \uD0A4\uBCF4\uB4DC\uB97C
      \uB450\uB4DC\uB9B4 \uB54C\uC758 \uC6B8\uB9BC\uACFC \uC18C\uB9AC\uC758 \uB290\uB08C\uC774
      \uB2EC\uB77C\uC9D1\uB2C8\uB2E4."
    _controls: "\uBCF4\uAC15\uD310 \uD0ED\uC5D0\uC11C \uD30C\uCE20 \uBAA9\uB85D\uC744
      \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - _topic: 24
    _title: "PCB \uAE30\uD310 \uC0B4\uD3B4\uBCF4\uAE30"
    _body: "PCB\uB294 \uC2A4\uC704\uCE58 \uC544\uB798\uC5D0 \uB193\uC774\uB294 \uD68C\uB85C
      \uAE30\uD310\uC785\uB2C8\uB2E4.\n\uC2A4\uC704\uCE58\uB97C \uB20C\uB800\uC744
      \uB54C \uBC1C\uC0DD\uD558\uB294 \uC2E0\uD638\uB97C \uC804\uB2EC\uD574 \uD0A4
      \uC785\uB825\uC744 \uC778\uC2DD\uD558\uAC8C \uD569\uB2C8\uB2E4.\n\uCF00\uC774\uC2A4\uC640
      \uBCF4\uAC15\uD310 \uC548\uCABD\uC5D0\uC11C \uD0A4\uBCF4\uB4DC\uC758 \uBC14\uD0D5\uC744
      \uC774\uB8E8\uB294 \uD30C\uCE20\uC785\uB2C8\uB2E4."
    _controls: "PCB \uC870\uB9BD \uAE30\uB2A5\uC774 \uCD94\uAC00\uB418\uBA74 \uC774
      \uC548\uB0B4\uB97C \uD1B5\uD574 \uC0AC\uC6A9\uBC95\uC744 \uD655\uC778\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - _topic: 25
    _title: "LED \uAFB8\uBBF8\uAE30"
    _body: "LED\uB85C \uD0A4\uBCF4\uB4DC\uC5D0 \uC6D0\uD558\uB294 \uC0C9\uACFC \uC6C0\uC9C1\uC784\uC744
      \uB354\uD574 \uBCF4\uC138\uC694.\n\uD55C \uAC00\uC9C0 \uC0C9\uC744 \uC720\uC9C0\uD558\uAC70\uB098,
      \uBB34\uC9C0\uAC1C\uAC00 \uD750\uB974\uB294 \uD6A8\uACFC\uC640 \uC740\uC740\uD558\uAC8C
      \uBC1D\uC544\uC84C\uB2E4 \uC5B4\uB450\uC6CC\uC9C0\uB294 \uD6A8\uACFC\uB97C
      \uC120\uD0DD\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uC870\uBA85\uC774 \uD544\uC694\uD558\uC9C0
      \uC54A\uC744 \uB54C\uB294 LED\uB97C \uAEBC\uB458 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    _controls: "LED \uD3B8\uC9D1 \uAE30\uB2A5\uC774 \uCD94\uAC00\uB418\uBA74 \uC774
      \uC548\uB0B4\uB97C \uD1B5\uD574 \uC0AC\uC6A9\uBC95\uC744 \uD655\uC778\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - _topic: 4
    _title: "\uC0AC\uC9C4\uC73C\uB85C \uD0A4\uBCF4\uB4DC \uAFB8\uBBF8\uAE30"
    _body: "\uC6D0\uD558\uB294 \uC0AC\uC9C4\uC744 \uBD88\uB7EC\uC640 \uD0A4\uCEA1\uC774\uB098
      \uCF00\uC774\uC2A4\uB97C \uAFB8\uBA70 \uBCF4\uC138\uC694.\n\uC804\uCCB4 \uD0A4\uCEA1\uC5D0
      \uC801\uC6A9\uD558\uBA74 \uD0A4\uBCF4\uB4DC \uC804\uCCB4\uAC00 \uD558\uB098\uC758
      \uCE94\uBC84\uC2A4\uCC98\uB7FC \uC774\uC5B4\uC9D1\uB2C8\uB2E4.\n\uC804\uCCB4
      \uC774\uBBF8\uC9C0 \uC801\uC6A9 \uC2DC \uAE30\uC874\uC758 \uAC1C\uBCC4 \uC774\uBBF8\uC9C0
      \uC124\uC815\uC744 \uB36E\uC5B4\uC4F0\uBBC0\uB85C \uC801\uC6A9 \uC804\uC5D0
      \uBBF8\uB9AC\uBCF4\uAE30\uB97C \uD655\uC778\uD558\uC138\uC694."
    _controls: "\uC774\uBBF8\uC9C0 \uD3B8\uC9D1 \uAE30\uB2A5\uC774 \uCD94\uAC00\uB418\uBA74
      \uC774 \uC548\uB0B4\uB97C \uD1B5\uD574 \uC0AC\uC6A9\uBC95\uC744 \uD655\uC778\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
