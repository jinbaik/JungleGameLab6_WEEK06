  m_Script: {fileID: 11500000, guid: 4af3e482865c49747941e483722a6cd8, type: 3}
  m_Name: WorkshopTutorial
  m_EditorClassIdentifier: Assembly-CSharp::Game.Tutorials.TutorialContent
  _cards:
  - _topic: 0
    _title: "\uB098\uB9CC\uC758 \uD0A4\uBCF4\uB4DC\uB85C \uB300\uACB0\uD558\uAE30"
    _body: "\uC791\uC5C5\uC2E4\uC5D0\uC11C \uD0A4\uBCF4\uB4DC\uB97C \uAFB8\uBBF8\uACE0
      \uD1A0\uB108\uBA3C\uD2B8\uC5D0 \uCC38\uAC00\uD558\uC138\uC694.\n\uD0A4\uBCF4\uB4DC
      \uBC1B\uAE30 \uC7A5\uCE58\uB97C <b>[\uC88C\uD074\uB9AD]</b>\uD574 \uD0A4\uBCF4\uB4DC\uB97C
      \uAEBC\uB0B4\uC138\uC694."
    _controls: "<b>[WASD]</b> \uC774\uB3D9   <b>[\uB9C8\uC6B0\uC2A4]</b> \uC2DC\uC810
      \uC774\uB3D9\n<b>[\uC88C\uD074\uB9AD]</b> \uBC1B\uAE30\xB7\uB4E4\uAE30   <b>[F10]</b>
      \uB3C4\uC6C0\uB9D0"
  - _topic: 1
    _title: "\uC791\uC5C5\uB300\uC5D0\uC11C \uC2DC\uC791\uD558\uC138\uC694"
    _body: "\uD0A4\uBCF4\uB4DC\uB97C \uB4E0 \uCC44 \uC791\uC5C5\uB300 \uC704\uB85C
      \uB358\uC838 \uB193\uC73C\uC138\uC694.\n\uC791\uC5C5\uB300 \uC704\uC758 \uD0A4\uBCF4\uB4DC\uB97C
      \uBC14\uB77C\uBCF4\uACE0 <b>[\uC6B0\uD074\uB9AD]</b>\uD558\uBA74 \uD3B8\uC9D1\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    _controls: "<b>[\uC88C\uD074\uB9AD]</b> \uB4E4\uAE30\xB7\uB358\uC9C0\uAE30  
      <b>[\uC6B0\uD074\uB9AD]</b> \uC791\uC5C5\uB300\uC5D0\uC11C \uD3B8\uC9D1"
  - _topic: 2
    _title: "\uB3CC\uB824 \uBCF4\uACE0, \uAFB8\uBA70 \uBCF4\uC138\uC694"
    _body: "\uD0A4\uBCF4\uB4DC \uC704\uC5D0\uC11C <b>[\uC88C\uD074\uB9AD \uB4DC\uB798\uADF8]</b>\uD558\uBA74
      \uD68C\uC804\uD558\uACE0, <b>[\uB9C8\uC6B0\uC2A4 \uD720]</b>\uB85C \uD655\uB300\xB7\uCD95\uC18C\uD569\uB2C8\uB2E4.\n<b>[\uC6B0\uD074\uB9AD]</b>\uD558\uBA74
      \uD3B8\uC9D1\uC744 \uB9C8\uCE69\uB2C8\uB2E4."
    _controls: "<b>[\uC88C\uD074\uB9AD \uB4DC\uB798\uADF8]</b> \uD68C\uC804   <b>[\uD720]</b>
      \uD655\uB300\xB7\uCD95\uC18C\n<b>[\uD720 \uD074\uB9AD]</b> \uD68C\uC804\xB7\uD0A4\uCEA1
      \uBCF5\uAD6C"
  - _topic: 3
    _title: "\uC804\uCCB4 \uB610\uB294 \uD558\uB098\uC529 \uBC14\uAFB8\uAE30"
    _body: "\uC804\uCCB4 \uD0A4\uCEA1 \uB610\uB294 \uD0A4\uCEA1 \uD55C \uAC1C\uB97C
      \uC120\uD0DD\uD558\uC138\uC694.\n\uC804\uCCB4\uB294 \uBBF8\uB9AC\uBCF4\uAE30
      \uD6C4 \uC801\uC6A9\uD558\uAE30\uB97C \uB204\uB985\uB2C8\uB2E4.\n\uD55C \uAC1C\uB294
      \uD0A4\uCEA1\uC744 \uC120\uD0DD\uD55C \uB4A4 \uC2E4\uC81C \uD0A4\uB97C \uB204\uB974\uBA74
      \uBC14\uB85C \uC801\uC6A9\uB429\uB2C8\uB2E4."
    _controls: "\uBAA9\uB85D\uC5D0\uC11C \uC6D0\uD558\uB294 \uD0A4\uCEA1\uC744 \uC120\uD0DD\uD558\uC138\uC694."
  - _topic: 4
    _title: "\uC804\uD22C \uB2A5\uB825 \uBBF8\uB9AC \uCCB4\uD5D8\uD558\uAE30"
    _body: "\uC2E4\uC81C \uD0A4\uBCF4\uB4DC\uB97C \uB20C\uB7EC \uD0A4\uCEA1\uC744
      \uD30C\uAD34\uD574 \uBCF4\uC138\uC694.\n\uC791\uC5C5\uC2E4\uC5D0\uC11C\uB294
      \uD0A4\uCEA1 \uB2A5\uB825\uC744 \uCD5C\uB300 3\uB2E8\uACC4\uB85C \uCCB4\uD5D8\uD569\uB2C8\uB2E4.
      \uC2E4\uC81C \uD1A0\uB108\uBA3C\uD2B8\uC5D0\uC11C\uB294 \uB530\uB85C \uD574\uAE08\uD574\uC57C
      \uD569\uB2C8\uB2E4."
    _controls: "<b>[\uD720 \uD074\uB9AD]</b> \uD30C\uAD34\uB41C \uD0A4\uCEA1\uACFC
      \uD68C\uC804 \uBCF5\uAD6C"
  - _topic: 5
    _title: "\uC678\uD615\uC740 \uADF8\uB300\uB85C, \uB2A5\uB825\uC740 \uD574\uAE08\uBD80\uD130"
    _body: "\uAFB8\uBBFC \uD0A4\uBCF4\uB4DC\uB85C \uC804\uD22C\uB97C \uC2DC\uC791\uD569\uB2C8\uB2E4.\n\uBD80\uD488
      \uB2A5\uB825\uC740 \uC7A0\uAE34 \uC0C1\uD0DC\uC774\uBA70, \uC2B9\uB9AC \uD6C4
      \uC0C1\uC810\uC5D0\uC11C \uC791\uC5C5\uC2E4\uC5D0 \uC0AC\uC6A9\uD55C \uBD80\uD488\uC744
      \uAD6C\uB9E4\uD574 \uD574\uAE08\uD569\uB2C8\uB2E4."
    _controls: "\uC804\uD22C\uC5D0 \uD544\uC694\uD55C \uBE48 \uC704\uCE58\uB294 \uAE30\uBCF8
      \uBD80\uD488\uC73C\uB85C \uCC44\uC6CC\uC9D1\uB2C8\uB2E4."
  - _topic: 6
    _title: "\uD0A4\uBCF4\uB4DC\uB97C \uBD80\uC218\uACE0 \uC810\uC218\uB97C \uACA8\uB8E8\uC138\uC694"
    _body: "\uC2E4\uC81C \uD0A4\uBCF4\uB4DC\uB97C \uB20C\uB7EC \uD0A4\uCEA1\uC744
      \uD0C0\uACA9\uD558\uC138\uC694.\n30\uCD08 \uB3D9\uC548 \uB85C\uBD07\uBCF4\uB2E4
      \uB192\uC740 \uC810\uC218\uB97C \uC5BB\uC73C\uBA74 \uC2B9\uB9AC\uD569\uB2C8\uB2E4.\n\uC77C\uC815
      \uC218\uB97C \uBD80\uC218\uBA74 \uB0A8\uC740 \uD0A4\uB3C4 \uC815\uC0B0\uD558\uACE0
      \uC0C8 \uD0A4\uBCF4\uB4DC\uB97C \uBCF4\uCDA9\uD569\uB2C8\uB2E4."
    _controls: "\uAFB8\uBBFC \uBD80\uD488\uC758 \uB2A5\uB825\uC740 \uC0C1\uC810\uC5D0\uC11C
      \uD574\uAE08\uD569\uB2C8\uB2E4.\n\uBC30\uCE58\uC640 \uD574\uAE08\xB7\uAC15\uD654\uB294
      \uD0A4\uBCF4\uB4DC \uBCF4\uCDA9 \uD6C4\uC5D0\uB3C4 \uC720\uC9C0\uB429\uB2C8\uB2E4."
  - _topic: 7
    _title: "\uC0C8 \uD0A4\uBCF4\uB4DC\uB85C \uACC4\uC18D \uACF5\uACA9\uD558\uC138\uC694"
    _body: "\uD544\uC694\uD55C \uC218\uC758 \uD0A4\uCEA1\uC744 \uD30C\uAD34\uD558\uBA74
      \uB0A8\uC740 \uD0A4\uCEA1\uB3C4 \uD30C\uAD34 \uC810\uC218\uB85C \uC815\uC0B0\uB429\uB2C8\uB2E4.\n\uC0C8
      \uD0A4\uBCF4\uB4DC\uC5D0\uB3C4 \uAE30\uC874 \uBC30\uCE58\uC640 \uD574\uAE08\xB7\uAC15\uD654
      \uC0C1\uD0DC\uAC00 \uC720\uC9C0\uB429\uB2C8\uB2E4."
    _controls: "\uB300\uC804\uC774 \uC9C4\uD589\uB418\uBA74 \uC644\uD30C\uC5D0 \uD544\uC694\uD55C
      \uD30C\uAD34 \uC218\uAC00 \uC99D\uAC00\uD569\uB2C8\uB2E4."
  - _topic: 8
    _title: "\uB0B4 \uBD80\uD488\uC758 \uB2A5\uB825 \uD574\uAE08\uD558\uAE30"
    _body: "\uC791\uC5C5\uC2E4\uC5D0\uC11C \uC0AC\uC6A9\uD55C \uBD80\uD488\uC774
      \uC0C1\uD488\uC73C\uB85C \uB4F1\uC7A5\uD569\uB2C8\uB2E4.\n\uD0A4\uCEA1 \uAD6C\uB9E4\uB294
      3\uAC1C \uC704\uCE58\uC5D0 \uC0AC\uC6A9\uD560 \uC218 \uC788\uACE0, \uCD95\xB7\uBCF4\uAC15\uD310\xB7\uD558\uC6B0\uC9D5\uC740
      \uAD6C\uB9E4 \uC989\uC2DC \uC804\uCCB4\uC5D0 \uC801\uC6A9\uB429\uB2C8\uB2E4."
    _controls: "\uC0C1\uC810 \uC7AC\uD654\uC640 \uB2A5\uB825 \uAC15\uD654\uB294 \uC774\uBC88
      \uD1A0\uB108\uBA3C\uD2B8\uC5D0\uC11C\uB9CC \uC720\uC9C0"
  - _topic: 9
    _title: "\uC801\uC6A9\uD560 \uC704\uCE58\uB97C \uACE0\uB974\uC138\uC694"
    _body: "\uBCF4\uC720 \uBAA9\uB85D\uC5D0\uC11C \uAD6C\uB9E4\uD55C \uD0A4\uCEA1\uC744
      \uC120\uD0DD\uD558\uACE0, \uC801\uC6A9\uD560 \uC704\uCE58\uC758 \uC2E4\uC81C
      \uD0A4\uB97C \uB204\uB974\uC138\uC694.\n\uAC19\uC740 \uC885\uB958\uC758 \uD0A4\uCEA1\uC774
      \uC7A5\uCC29\uB41C \uC704\uCE58\uC5D0\uB9CC \uC801\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    _controls: "\uD55C \uBB36\uC74C\uC740 \uC11C\uB85C \uB2E4\uB978 3\uAC1C \uC704\uCE58\uC5D0
      \uD55C \uBC88\uC529 \uC801\uC6A9"
  - _topic: 10
    _title: "\uAC19\uC740 \uC704\uCE58\uB97C \uB354 \uAC15\uD558\uAC8C"
    _body: "\uC544\uC774\uBCF4\uB9AC\uC0C9 \uC678\uACFD\uC120\uC740 \uB2A5\uB825\uC774
      \uD574\uAE08\uB410\uB2E4\uB294 \uD45C\uC2DC\uC785\uB2C8\uB2E4.\n\uB2E4\uC2DC
      \uAD6C\uB9E4\uD558\uBA74 \uAC19\uC740 \uC704\uCE58\uB97C \uCD5C\uB300 3\uB2E8\uACC4\uAE4C\uC9C0
      \uAC15\uD654\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    _controls: "\uBCF4\uC720 \uBAA9\uB85D\uC758 \uD0A4\uCEA1\uC744 <b>[\uC6B0\uD074\uB9AD]</b>\uD558\uBA74
      \uB9C8\uC9C0\uB9C9 \uC801\uC6A9\uC744 \uD55C \uB2E8\uACC4 \uCDE8\uC18C"
  - _topic: 11
    _title: "\uD0A4\uBCF4\uB4DC \uC804\uCCB4\uC5D0 \uC801\uC6A9\uB418\uB294 \uAC15\uD654"
    _body: "\uCD95\xB7\uBCF4\uAC15\uD310\xB7\uD558\uC6B0\uC9D5\uC740 \uAD6C\uB9E4
      \uC989\uC2DC \uD0A4\uBCF4\uB4DC \uC804\uCCB4\uC758 \uD0C0\uACA9 \uD53C\uD574\uB97C
      \uB192\uC785\uB2C8\uB2E4.\n\uAC19\uC740 \uBD80\uD488\uC744 \uB2E4\uC2DC \uAD6C\uB9E4\uD558\uBA74
      \uCD5C\uB300 3\uB2E8\uACC4\uAE4C\uC9C0 \uAC15\uD654\uB429\uB2C8\uB2E4."
    _controls: "\uD0A4\uCEA1\uCC98\uB7FC \uC801\uC6A9 \uC704\uCE58\uB97C \uACE0\uB974\uC9C0
      \uC54A\uC544\uB3C4 \uB429\uB2C8\uB2E4."
  - _topic: 12
    _title: "\uC544\uD2F0\uC0B0\uC740 \uD55C \uAC1C\uC529, \uCD5C\uB300 3\uAC1C"
    _body: "\uC804\uCCB4 \uC801\uC6A9\uC740 \uBD88\uAC00\uD558\uBA70 \uD55C \uAC1C\uC529
      \uBC30\uCE58\uD569\uB2C8\uB2E4.\n\uAC19\uC740 \uC885\uB958\uB97C \uD3EC\uD568\uD574
      \uCD5C\uB300 3\uAC1C\uAE4C\uC9C0 \uC7A5\uCC29\uD569\uB2C8\uB2E4.\n\uC77C\uBC18
      \uD0A4\uCEA1\uACFC \uB2EC\uB9AC \uB2E4\uB978 \uD0A4\uB97C \uAC15\uD654\uD558\uB294
      \uD328\uC2DC\uBE0C\uC785\uB2C8\uB2E4."
    _controls: "\uACF5\uACA9 \uBAA8\uB4DC\uC5D0\uC11C \uB2A5\uB825\uACFC \uD45C\uC2DD\uC744
      \uCCB4\uD5D8\uD558\uC138\uC694.\n<b>[\uC2E4\uC81C \uD0A4 \uC785\uB825]</b>
      \uBC30\uCE58  \xB7  <b>[\uD720 \uD074\uB9AD]</b> \uBCF5\uAD6C"
  - _topic: 13
    _title: "\uC774\uBBF8\uC9C0\uB97C \uC785\uD600\uB3C4 \uB2A5\uB825\uC740 \uADF8\uB300\uB85C"
    _body: "\uC774\uBBF8\uC9C0\uB97C \uC801\uC6A9\uD574\uB3C4 \uC6D0\uB798 \uD0A4\uCEA1\uC758
      \uC885\uB958\uC640 \uB2A5\uB825\uC740 \uC720\uC9C0\uB429\uB2C8\uB2E4.\n\uC804\uCCB4
      \uD0A4\uCEA1\uC5D0 \uC774\uBBF8\uC9C0\uB97C \uC801\uC6A9\uD558\uBA74 \uAE30\uC874\uC758
      \uAC1C\uBCC4 \uC774\uBBF8\uC9C0 \uC124\uC815\uC744 \uB36E\uC5B4\uC501\uB2C8\uB2E4."
    _controls: "\uC774\uBBF8\uC9C0 \uC120\uD0DD \u2192 \uC801\uC6A9 \uC704\uCE58\xB7\uBC94\uC704
      \uC120\uD0DD \u2192 \uC801\uC6A9"
  - _topic: 14
    _title: "\uC0C1\uD488 \uB2E4\uC2DC \uBF51\uAE30"
    _body: "\uC7AC\uD654 5\uB97C \uC0AC\uC6A9\uD574 \uC0C1\uD488\uC744 \uB2E4\uC2DC
      \uBF51\uC2B5\uB2C8\uB2E4.\n\uC0C1\uC810 \uBC29\uBB38\uB9C8\uB2E4 \uCD5C\uB300
      3\uBC88 \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    _controls: "\uB9AC\uB864 \uBE44\uC6A9\uC740 \uBD80\uD488 \uAD6C\uB9E4\uC5D0 \uC4F0\uB294
      \uC7AC\uD654\uC5D0\uC11C \uCC28\uAC10\uB429\uB2C8\uB2E4."
  - _topic: 15
    _title: "\uB2E4\uC74C \uD0A4\uBCF4\uB4DC\uB97C \uC124\uACC4\uD574 \uBCF4\uC138\uC694"
    _body: "\uC791\uC5C5\uC2E4\uB85C \uB3CC\uC544\uAC00 \uAD6C\uC131\uC744 \uC218\uC815\uD558\uACE0
      \uB2E4\uC2DC \uB3C4\uC804\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uC774\uBC88
      \uD1A0\uB108\uBA3C\uD2B8\uC758 \uC0C1\uC810 \uC7AC\uD654\uC640 \uD574\uAE08\xB7\uAC15\uD654\uB294
      \uCD08\uAE30\uD654\uB429\uB2C8\uB2E4."
    _controls: "\uC791\uC5C5\uC2E4 \uBCF4\uC0C1 \uACE8\uB4DC\uC640 \uC0C1\uC810 \uC7AC\uD654\uB294
      \uBCC4\uAC1C\uC785\uB2C8\uB2E4."
