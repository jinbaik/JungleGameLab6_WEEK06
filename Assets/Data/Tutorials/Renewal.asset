  m_Script: {fileID: 11500000, guid: 4af3e482865c49747941e483722a6cd8, type: 3}
  m_Name: Renewal
  m_EditorClassIdentifier: Assembly-CSharp::Game.Tutorials.TutorialContent
  _cards:
  - _topic: 1
    _title: "\uC791\uC5C5 \uC2DC\uC791\uD558\uAE30"
    _body: "\uBAA8\uB2C8\uD130\uC758 \uBA54\uC77C \uC571\uC5D0\uC11C \uC758\uB8B0\uB97C
      \uC218\uB77D\uD558\uC138\uC694.\nEsc\uB85C \uB098\uC628 \uB4A4 \uC791\uC5C5\uB300\uB97C
      \uBC14\uB77C\uBCF4\uACE0 \uC6B0\uD074\uB9AD\uD558\uC138\uC694.\n\uD558\uBD80
      \uD558\uC6B0\uC9D5 \uC11C\uB78D\uC744 \uC5F4\uACE0, \uC6D0\uD558\uB294 \uD558\uC6B0\uC9D5\uC744
      \uC791\uC5C5\uB300\uC5D0 \uB04C\uC5B4\uB2E4 \uB193\uC73C\uC138\uC694."
    _controls: "<b>[\uB9C8\uC6B0\uC2A4 \uC774\uB3D9]</b> \uB458\uB7EC\uBCF4\uAE30  
      <b>[\uC791\uC5C5\uB300 \uC6B0\uD074\uB9AD]</b> \uC791\uC5C5 \uBAA8\uB4DC\n<b>[Esc]</b>
      \uC9D1\uC911 \uBAA8\uB4DC \uB098\uAC00\uAE30   <b>[F10]</b> \uB3C4\uC6C0\uB9D0"
  - _topic: 29
    _title: "\uC870\uB9BD \uC21C\uC11C"
    _body: "\uD558\uBD80 \uD558\uC6B0\uC9D5 \u2192 PCB \u2192 \uB098\uC0AC 6\uAC1C
      \u2192 \uBCF4\uAC15\uD310\n\u2192 \uC2A4\uC704\uCE58 \u2192 \uC0C1\uB2E8\uBD80
      \u2192 \uD0A4\uCEA1 \uC21C\uC11C\uB85C \uC870\uB9BD\uD558\uC138\uC694.\nPCB
      \uB098\uC0AC 6\uAC1C\uB97C \uBAA8\uB450 \uC870\uC5EC\uC57C \uC2A4\uC704\uCE58\uB97C
      \uC124\uCE58\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    _controls: "<b>[PCB \uC11C\uB78D \uC5F4\uAE30 \u2192 \uB098\uC0AC \uC88C\uD074\uB9AD]</b>
      \uC870\uC774\uAE30\xB7\uD480\uAE30\n\uC8FC\uD669\uC0C9\uC740 \uBBF8\uCCB4\uACB0,
      \uCD08\uB85D\uC0C9\uC740 \uCCB4\uACB0 \uC0C1\uD0DC\uC785\uB2C8\uB2E4."
  - _topic: 17
    _title: "\uBD80\uD488 \uAEBC\uB0B4 \uC124\uCE58\uD558\uAE30"
    _body: "\uC791\uC5C5 \uBAA8\uB4DC\uC5D0\uC11C \uC11C\uB78D\uC744 \uD074\uB9AD\uD574
      \uC5F4\uACE0, \uBD80\uD488 \uCE74\uB4DC\uB97C \uC124\uCE58\uD560 \uC790\uB9AC\uC5D0
      \uB04C\uC5B4\uB2E4 \uB193\uC73C\uC138\uC694.\n\uD0A4\uCEA1\uC740 \uC2A4\uC704\uCE58\uAC00
      \uC788\uB294 \uBE48 \uC790\uB9AC\uC5D0 \uC124\uCE58\uD569\uB2C8\uB2E4."
    _controls: "<b>[\uD720]</b> \uBAA9\uB85D \uC774\uB3D9   <b>[\uCE74\uB4DC \uB4DC\uB798\uADF8]</b>
      \uC124\uCE58\n<b>[\uB2EB\uAE30 \uBC84\uD2BC / \uC5F4\uB9B0 \uC11C\uB78D \uD074\uB9AD]</b>
      \uC11C\uB78D \uB2EB\uAE30"
  - _topic: 18
    _title: "\uBD80\uD488 \uBD84\uB9AC\uD558\uAE30"
    _body: "\uD0A4\uCEA1\xB7\uC2A4\uC704\uCE58\uB294 \uD480\uB7EC\uB85C \uBD84\uB9AC\uD558\uBA74
      \uC790\uB3D9 \uD68C\uC218\uB429\uB2C8\uB2E4. \n\uD0A4\uCEA1\uC744 \uBA3C\uC800
      \uBE7C\uC57C \uC2A4\uC704\uCE58\uB97C \uBD84\uB9AC\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uBD84\uB9AC\uD560
      \uBD80\uD488\uC758 \uC11C\uB78D\uC744 \uC5F4\uACE0, \uC7A5\uCC29\uB41C \uBD80\uD488\uC744
      \uB04C\uC5B4\uB0B4\uC138\uC694. \uC11C\uB78D\uC5D0 \uB193\uC73C\uBA74 \uBC18\uB0A9\uB429\uB2C8\uB2E4."
    _controls: "<b>[\uBD84\uB9AC \uC21C\uC11C]</b> \uC0C1\uB2E8\uBD80\xB7\uD0A4\uCEA1
      \u2192 \uBCF4\uAC15\uD310\n\u2192 \uB098\uC0AC 6\uAC1C \uD574\uC81C \u2192
      PCB"
  - _topic: 6
    _title: "\uC2A4\uC704\uCE58\xB7\uD0A4\uCEA1 \uC5F0\uC18D \uC124\uCE58"
    _body: "\uC124\uCE58\uD560 \uC2A4\uC704\uCE58\uB098 \uD0A4\uCEA1\uC744 \uB204\uB978
      \uCC44 \uD0A4\uBCF4\uB4DC \uC704\uB85C \uB4DC\uB798\uADF8\uD558\uC138\uC694.\n\uB204\uB978
      \uCC44 \uC6C0\uC9C1\uC774\uBA74 \uC124\uCE58\uB418\uBA70, \uB9C8\uC6B0\uC2A4\uC5D0\uC11C
      \uC190\uC744 \uB5BC\uBA74 \uC885\uB8CC\uB429\uB2C8\uB2E4."
    _controls: "<b>[\uC88C\uD074\uB9AD \uC720\uC9C0 + \uC774\uB3D9]</b> \uC5F0\uC18D
      \uC124\uCE58\n\uC2A4\uC704\uCE58\uB294 PCB \uB098\uC0AC \uCCB4\uACB0 \uD6C4,
      \uD0A4\uCEA1\uC740 \uC2A4\uC704\uCE58 \uC704\uC5D0 \uC124\uCE58\uD558\uC138\uC694."
  - _topic: 34
    _title: "\uBAA8\uB2C8\uD130 \uC0AC\uC6A9\uD558\uAE30"
    _body: "\uBAA8\uB2C8\uD130 \uD654\uBA74\uC744 \uD074\uB9AD\uD558\uC138\uC694.\nEsc\uB97C
      \uB204\uB974\uBA74 \uBAA8\uB2C8\uD130 \uC0AC\uC6A9\uC744 \uB9C8\uCE69\uB2C8\uB2E4.\n\uBA54\uC77C
      \uC571\uC5D0\uC11C \uACE0\uAC1D \uC758\uB8B0\uB97C \uD655\uC778\uD560 \uC218
      \uC788\uC2B5\uB2C8\uB2E4."
    _controls: "<b>[\uC544\uC774\uCF58 \uB354\uBE14\uD074\uB9AD]</b> \uC571 \uC2E4\uD589\n<b>[Esc]</b>
      \uBAA8\uB2C8\uD130 \uC870\uC791 \uC885\uB8CC"
  - _topic: 32
    _title: "\uC758\uB8B0 \uD655\uC778\xB7\uC218\uB77D\uD558\uAE30"
    _body: "\uBA54\uC77C \uC571\uC5D0\uC11C \uACE0\uAC1D \uC774\uB984\uC744 \uD3BC\uCE58\uACE0
      \uC758\uB8B0 \uBA54\uC77C\uC744 \uC120\uD0DD\uD558\uC138\uC694.\n\uC694\uAD6C\uC0AC\uD56D\uC744
      \uC77D\uACE0 \uC758\uB8B0\uB97C \uC218\uB77D\uD55C \uB4A4 \uD0A4\uBCF4\uB4DC\uB97C
      \uC81C\uC791\uD558\uC138\uC694.\n\uC81C\uC791 \uC911\uC5D0\uB294 \uD654\uBA74\uC758
      \uCCB4\uD06C\uB9AC\uC2A4\uD2B8\uB85C \uC694\uAD6C\uC0AC\uD56D \uCDA9\uC871
      \uC5EC\uBD80\uB97C \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    _controls: "<b>[\uACE0\uAC1D \uD074\uB9AD]</b> \uBAA9\uB85D \uD3BC\uCE58\uAE30\xB7\uC811\uAE30\n<b>[\uC758\uB8B0
      \uBA54\uC77C \uC120\uD0DD \u2192 \uC758\uB8B0 \uC218\uB77D]</b> \uC81C\uC791
      \uC2DC\uC791"
  - _topic: 33
    _title: "\uD0A4\uBCF4\uB4DC \uBC30\uC1A1\uD558\uAE30"
    _body: "\uC644\uC131\uD55C \uD0A4\uBCF4\uB4DC\uB97C \uBC30\uC1A1 \uD2B8\uB808\uC774\uC5D0
      \uC62C\uB9AC\uC138\uC694.\n\uB2E8\uB9D0\uAE30\uC5D0 \uD45C\uC2DC\uB41C \uACE0\uAC1D\xB7\uC758\uB8B0\uB97C
      \uD655\uC778\uD558\uACE0 \uBC1C\uC1A1\uC744 \uB204\uB978 \uB4A4, \uD655\uC778
      \uCC3D\uC5D0\uC11C \uCD5C\uC885 \uBC1C\uC1A1\uD558\uC138\uC694.\n\uAC80\uC218
      \uACB0\uACFC\uB294 \uBA54\uC77C \uC571\uC5D0\uC11C \uD574\uB2F9 \uACE0\uAC1D\uC758
      \uACB0\uACFC \uBA54\uC77C\uC744 \uC5F4\uC5B4 \uD655\uC778\uD558\uC138\uC694."
    _controls: "<b>[Q / E]</b> \uBC30\uC1A1 \uC2DC\uC810 \uC774\uB3D9\n\uBC1C\uC1A1\uD55C
      \uD0A4\uBCF4\uB4DC\uB294 \uB3CC\uB824\uBC1B\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
